{
  "id": "aiostreams-torrent-provider",
  "name": "AIOLiveTV",
  "version": "0.8.3",
  "manifestURI": "",
  "language": "typescript",
  "type": "anime-torrent-provider",
  "description": "AIOLiveTV bridge for Seanime anime torrent search.",
  "author": "mrcanelas",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/aiostreams-light.png",
  "lang": "multi",
  "payloadURI": "",
  "website": "https://github.com/mrcanelas/aiolivetv",
  "readme": "https://github.com/mrcanelas/aiolivetv/blob/main/packages/docs/content/docs/guides/seanime.mdx",
  "notes": "You need an existing AIOLiveTV instance and configuration to use this plugin.",
  "isDevelopment": true,
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "manifestUrl",
        "label": "AIOLiveTV Manifest URL",
        "type": "text",
        "default": ""
      },
      {
        "name": "searchId",
        "label": "AIOLiveTV Search ID",
        "type": "select",
        "default": "imdbId",
        "options": [
          {
            "label": "IMDb ID",
            "value": "imdbId"
          },
          {
            "label": "Kitsu ID",
            "value": "kitsuId"
          },
          {
            "label": "AniList ID",
            "value": "anilistId"
          }
        ]
      },
      {
        "name": "resultFormat",
        "label": "Result Name Format",
        "type": "select",
        "default": "formatter",
        "options": [
          {
            "label": "Filename",
            "value": "filename"
          },
          {
            "label": "Formatter",
            "value": "formatter"
          }
        ]
      }
    ]
  }
}