{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/refs/heads/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "node",
      "versioning": "default",
      "prerelease": false,
      "include-component-in-tag": false,
      "changelog-type": "default",
      "pull-request-header": "## AIOLiveTV — next release\n\nThis release brings together the latest features, improvements and fixes. The notes below include both direct commits and merged pull requests.",
      "pull-request-footer": "Thank you to everyone contributing code, reporting issues and sharing feedback!",
      "exclude-paths": [
        ".env.sample",
        ".gitignore",
        ".release-please-manifest.json",
        "compose.yaml"
      ],
      "pull-request-title-pattern": "chore: release ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "resources/metadata.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
